<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LNCT Event Manager — College Event Management</title>

  <!-- React + ReactDOM: works in most online HTML compilers -->
  <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

  <style>
    :root{
      --navy:#08111f;
      --navy2:#0d1b2e;
      --blue:#2563eb;
      --cyan:#22d3ee;
      --gold:#f4b942;
      --red:#ef4444;
      --green:#22c55e;
      --bg:#f5f7fb;
      --card:#ffffff;
      --text:#142033;
      --muted:#6b7280;
      --border:#e5e9f0;
      --shadow:0 12px 35px rgba(10,25,50,.08);
      --radius:18px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
    button,input,select,textarea{font:inherit}
    button{cursor:pointer}
    .app{min-height:100vh}

    /* TOP BAR */
    .topbar{
      position:sticky;top:0;z-index:50;
      height:72px;background:rgba(8,17,31,.96);color:white;
      display:flex;align-items:center;justify-content:space-between;
      padding:0 28px;backdrop-filter:blur(14px);
      border-bottom:1px solid rgba(255,255,255,.08)
    }
    .brand{display:flex;align-items:center;gap:12px;min-width:230px}
    .brand img{width:45px;height:45px;border-radius:50%;object-fit:cover;background:white;border:2px solid #fff}
    .brand-title{font-weight:800;font-size:17px;letter-spacing:.2px}
    .brand-sub{font-size:11px;color:#aeb9c9;margin-top:2px}
    .top-actions{display:flex;gap:10px;align-items:center}
    .icon-btn,.profile{
      border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);
      color:white;border-radius:12px;padding:10px 13px
    }
    .profile{display:flex;gap:9px;align-items:center}
    .avatar{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#2563eb,#22d3ee);font-weight:800}

    /* LAYOUT */
    .layout{display:grid;grid-template-columns:250px 1fr;min-height:calc(100vh - 72px)}
    .sidebar{
      background:var(--navy);color:#d8e1ee;padding:22px 14px;
      position:sticky;top:72px;height:calc(100vh - 72px);overflow:auto
    }
    .side-label{font-size:10px;text-transform:uppercase;letter-spacing:1.4px;color:#718096;margin:16px 12px 8px}
    .nav{
      width:100%;display:flex;align-items:center;gap:11px;
      padding:12px 13px;margin:3px 0;border:0;background:transparent;color:#b9c6d8;
      border-radius:12px;text-align:left;font-weight:600;transition:.2s
    }
    .nav:hover{background:rgba(255,255,255,.06);color:white}
    .nav.active{background:linear-gradient(90deg,rgba(37,99,235,.35),rgba(34,211,238,.08));color:white}
    .nav .ico{width:24px;text-align:center}
    .sidebar-bottom{margin-top:24px;padding:15px;border:1px solid rgba(255,255,255,.08);border-radius:15px;background:rgba(255,255,255,.035)}
    .sidebar-bottom strong{display:block;font-size:12px}
    .sidebar-bottom span{font-size:11px;color:#8492a8}

    .main{min-width:0}
    .content{max-width:1500px;margin:auto;padding:28px}
    .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}
    .eyebrow{font-size:12px;color:var(--blue);font-weight:800;text-transform:uppercase;letter-spacing:1.2px}
    h1{margin:5px 0 4px;font-size:30px;letter-spacing:-.8px}
    .subtitle{color:var(--muted);margin:0}
    .primary{
      border:0;border-radius:12px;background:var(--blue);color:white;padding:12px 17px;
      font-weight:800;box-shadow:0 8px 18px rgba(37,99,235,.22)
    }
    .secondary{border:1px solid var(--border);border-radius:12px;background:white;padding:11px 15px;font-weight:700;color:var(--text)}
    .primary:hover{filter:brightness(1.07)}

    /* HERO */
    .hero{
      background:linear-gradient(125deg,#071426 0%,#102744 58%,#164e63 100%);
      border-radius:24px;color:white;padding:28px;display:grid;
      grid-template-columns:1.6fr .9fr;gap:22px;overflow:hidden;position:relative;
      box-shadow:var(--shadow)
    }
    .hero:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-100px;top:-100px;background:rgba(34,211,238,.14)}
    .hero h2{font-size:32px;margin:0 0 10px;max-width:650px}
    .hero p{color:#bdcbe0;line-height:1.6;max-width:650px}
    .hero-chips{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
    .chip{padding:7px 10px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);font-size:12px}
    .hero-logo{display:grid;place-items:center;z-index:1}
    .hero-logo img{width:190px;height:190px;object-fit:cover;border-radius:50%;border:7px solid rgba(255,255,255,.88);box-shadow:0 15px 40px rgba(0,0,0,.3)}

    /* STATS */
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:20px 0}
    .stat{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:17px;box-shadow:var(--shadow)}
    .stat-top{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;font-weight:700}
    .stat-num{font-size:27px;font-weight:900;margin-top:8px}
    .stat-note{font-size:11px;color:#16a34a;margin-top:5px}

    /* SECTIONS */
    .grid-2{display:grid;grid-template-columns:1.3fr .7fr;gap:20px}
    .card{background:white;border:1px solid var(--border);border-radius:18px;box-shadow:var(--shadow);padding:20px}
    .card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px}
    .card-head h3{margin:0;font-size:17px}
    .muted{color:var(--muted);font-size:13px}

    /* EVENTS */
    .event-list{display:grid;gap:10px}
    .event{
      display:grid;grid-template-columns:58px 1fr auto;gap:14px;align-items:center;
      padding:13px;border:1px solid var(--border);border-radius:14px;background:#fff;transition:.2s
    }
    .event:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(10,25,50,.08)}
    .datebox{border-radius:12px;background:#eef4ff;color:var(--blue);text-align:center;padding:8px 4px;font-weight:900}
    .datebox b{display:block;font-size:20px}
    .datebox span{font-size:9px;text-transform:uppercase}
    .event-title{font-weight:800;margin-bottom:4px}
    .event-meta{font-size:12px;color:var(--muted)}
    .tag{font-size:10px;font-weight:800;padding:5px 8px;border-radius:999px;display:inline-block}
    .tag.blue{background:#e8f0ff;color:#2457c5}.tag.green{background:#e8f8ef;color:#13843f}
    .tag.gold{background:#fff5db;color:#9b6a00}.tag.red{background:#ffe9e9;color:#b91c1c}
    .event-actions{display:flex;gap:7px}
    .small-btn{border:1px solid var(--border);background:white;border-radius:9px;padding:7px 9px;font-size:11px;font-weight:800}

    /* POSTERS */
    .poster-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
    .poster{min-height:170px;border-radius:15px;padding:16px;color:white;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}
    .poster:nth-child(1){background:linear-gradient(140deg,#172554,#2563eb)}
    .poster:nth-child(2){background:linear-gradient(140deg,#3b0764,#c026d3)}
    .poster:nth-child(3){background:linear-gradient(140deg,#422006,#f59e0b)}
    .poster:before{content:"";position:absolute;width:130px;height:130px;border:1px solid rgba(255,255,255,.2);border-radius:50%;right:-35px;top:-35px}
    .poster h4{margin:0 0 5px;font-size:16px;z-index:1}
    .poster p{margin:0;font-size:11px;color:#e7eaf1;z-index:1}

    /* TOOLS */
    .tools{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
    .tool{padding:15px;border:1px solid var(--border);border-radius:14px;background:#fff;cursor:pointer;transition:.2s}
    .tool:hover{border-color:#b7cdfc;transform:translateY(-2px)}
    .tool-icon{font-size:24px}.tool b{display:block;margin-top:7px}.tool span{font-size:11px;color:var(--muted)}

    /* TABLE */
    .table-wrap{overflow:auto;border:1px solid var(--border);border-radius:14px}
    table{width:100%;border-collapse:collapse;min-width:680px}
    th,td{padding:13px 14px;text-align:left;border-bottom:1px solid var(--border);font-size:12px}
    th{background:#f8fafc;color:#657084;font-size:10px;text-transform:uppercase;letter-spacing:.7px}
    tr:last-child td{border-bottom:0}

    /* ABOUT */
    .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .info-line{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
    .info-line:last-child{border:0}.info-ico{width:32px}
    .timeline{border-left:2px solid #dbe5f6;margin-left:7px;padding-left:20px}
    .timeline-item{position:relative;margin-bottom:20px}.timeline-item:before{content:"";position:absolute;left:-27px;top:3px;width:10px;height:10px;border-radius:50%;background:var(--blue);border:3px solid #dbe5f6}

    /* MODAL */
    .overlay{position:fixed;inset:0;background:rgba(4,10,20,.6);display:grid;place-items:center;z-index:100;padding:18px}
    .modal{background:white;border-radius:20px;width:min(680px,100%);max-height:90vh;overflow:auto;box-shadow:0 25px 80px rgba(0,0,0,.3)}
    .modal-head{padding:19px 20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
    .modal-head h3{margin:0}.close{border:0;background:#f1f3f6;width:34px;height:34px;border-radius:9px}
    .modal-body{padding:20px}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
    .field{display:flex;flex-direction:column;gap:6px}.field.full{grid-column:1/-1}
    .field label{font-size:11px;font-weight:800;color:#566174}
    .field input,.field select,.field textarea{border:1px solid var(--border);border-radius:10px;padding:11px;outline:none;background:#fff}
    .field input:focus,.field select:focus,.field textarea:focus{border-color:#7da5f5;box-shadow:0 0 0 3px #eaf1ff}
    .modal-foot{display:flex;justify-content:flex-end;gap:9px;padding:15px 20px;border-top:1px solid var(--border)}

    /* TOAST */
    .toast{position:fixed;right:22px;bottom:22px;background:#101827;color:white;padding:13px 16px;border-radius:12px;box-shadow:0 12px 35px rgba(0,0,0,.25);z-index:150;font-size:13px}
    .search{border:1px solid var(--border);background:white;border-radius:11px;padding:10px 12px;width:240px;outline:none}
    .filter-row{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:14px}

    /* MOBILE */
    @media(max-width:1000px){
      .layout{grid-template-columns:1fr}.sidebar{position:sticky;top:72px;height:auto;padding:8px;z-index:40;display:flex;overflow:auto;gap:4px}.side-label,.sidebar-bottom{display:none}.nav{white-space:nowrap;width:auto}.nav .ico{width:auto}
      .hero{grid-template-columns:1fr}.hero-logo{display:none}.grid-2,.about-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:650px){
      .topbar{padding:0 13px}.brand{min-width:0}.brand-title{font-size:13px}.brand-sub{display:none}.top-actions .icon-btn{display:none}
      .content{padding:17px}.page-head{align-items:flex-start;flex-direction:column}.page-head .primary{width:100%}
      h1{font-size:25px}.stats{grid-template-columns:1fr 1fr}.poster-grid,.tools{grid-template-columns:1fr}.event{grid-template-columns:48px 1fr}.event-actions{grid-column:2}.form-grid{grid-template-columns:1fr}
      .search{width:100%}.filter-row{flex-direction:column}
    }
  
/* ===== Student Project UI Improvements ===== */
