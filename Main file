</style>
</head>

<body>
<div id="root"></div>

<script type="text/babel">
const {useState, useMemo} = React;

const LOGO = "data:image/jpeg;base64,";

const initialEvents = [
  {id:1, day:"12", month:"OCT", title:"TechFest 2026", category:"Technical", venue:"LNCT Auditorium", time:"10:00 AM", status:"Upcoming", tag:"blue"},
  {id:2, day:"18", month:"OCT", title:"E-Summit & Startup Meet", category:"Entrepreneurship", venue:"Innovation Hub", time:"11:30 AM", status:"Upcoming", tag:"gold"},
  {id:3, day:"25", month:"OCT", title:"Inter-College Cricket", category:"Sports", venue:"LNCT Sports Ground", time:"8:00 AM", status:"Registration", tag:"green"},
  {id:4, day:"02", month:"NOV", title:"Cultural Night", category:"Cultural", venue:"Open Air Theatre", time:"6:00 PM", status:"Planning", tag:"red"}
];

// Main React component - all pages are controlled from here.
function App(){
  const [page,setPage] = useState("Dashboard");
  const [events,setEvents] = useState(initialEvents);
  const [modal,setModal] = useState(null);
  const [toast,setToast] = useState("");
  const [query,setQuery] = useState("");
  const [registered,setRegistered] = useState([]);

  const notify = (msg) => {
    setToast(msg);
    setTimeout(()=>setToast(""),2600);
  };

  const filtered = useMemo(()=>events.filter(e =>
    (e.title+" "+e.category+" "+e.venue).toLowerCase().includes(query.toLowerCase())
  ),[events,query]);

  const addEvent = (data) => {
    const d = new Date(data.date + "T00:00:00");
    const month = d.toLocaleString("en-US",{month:"short"}).toUpperCase();
    const day = String(d.getDate()).padStart(2,"0");
    const newEvent = {
      id:Date.now(), day, month, title:data.title, category:data.category,
      venue:data.venue, time:data.time, status:"Planning", tag:"blue"
    };
    setEvents(prev=>[newEvent,...prev]);
    setModal(null);
    notify("Event created successfully.");
  };

  const register = (id) => {
    if(registered.includes(id)) { notify("You are already registered."); return; }
    setRegistered(prev=>[...prev,id]);
    notify("Registration confirmed.");
  };

  return (
    <div className="app">
      <header className="topbar">
        <div className="brand">
          <img src={LOGO} alt="LNCT college logo"/>
          <div>
            <div className="brand-title">LNCT Event Manager</div>
            <div className="brand-sub">Lakshmi Narain College of Technology, Bhopal</div>
          </div>
        </div>
        <div className="top-actions">
          <button className="icon-btn" onClick={()=>notify("No new notifications.")}>🔔</button>
          <button className="profile" onClick={()=>notify("Logged in as Event Coordinator")}><span className="avatar">SS</span><span>Coordinator</span>⌄</button>
        </div>
      </header>

      <div className="layout">
        <aside className="sidebar">
          <div className="side-label">Workspace</div>
          {[
            ["Dashboard","⌂"],["Events","▣"],["Calendar","◫"],["Registrations","✓"],
            ["Event Resources","⚙"],["Posters","▤"],["College Info","◎"]
          ].map(([name,ico]) =>
            <button key={name} className={"nav "+(page===name?"active":"")} onClick={()=>setPage(name)}>
              <span className="ico">{ico}</span>{name}
            </button>
          )}
          <div className="side-label">Management</div>
          <button className="nav" onClick={()=>setModal("create")}>＋ Create Event</button>
          <div className="sidebar-bottom">
            <strong>LNCT Event Operations</strong>
            <span>Plan • Publish • Register • Execute</span>
          </div>
        </aside>

        <main className="main">
          <div className="content">
            {page==="Dashboard" && <Dashboard events={events} registered={registered} setPage={setPage} setModal={setModal} register={register} notify={notify}/>}
            {page==="Events" && <Events events={filtered} query={query} setQuery={setQuery} setModal={setModal} register={register} registered={registered} notify={notify}/>}
            {page==="Calendar" && <Calendar events={events} notify={notify}/>}
            {page==="Registrations" && <Registrations events={events} registered={registered} notify={notify}/>}
            {page==="Event Resources" && <Resources notify={notify}/>}
            {page==="Posters" && <Posters notify={notify}/>}
            {page==="College Info" && <CollegeInfo notify={notify}/>}
          </div>
        </main>
      </div>

      {modal==="create" && <CreateModal onClose={()=>setModal(null)} onSave={addEvent}/>}
      {modal==="details" && <EventDetails onClose={()=>setModal(null)} register={register} event={modal.event}/>}
      {toast && <div className="toast" aria-live="polite">✓ {toast}</div>}
    </div>
  );
}

// Dashboard page
function Dashboard({events,registered,setPage,setModal,register,notify}){
  return <div>
    <div className="page-head">
      <div><div className="eyebrow">Student Event Management Project</div><h1>Welcome to LNCT Event Manager 👋</h1><p className="subtitle">Manage LNCT events, registrations, resources and event-day operations from one place.</p></div>
      <button className="primary" onClick={()=>setModal("create")}>＋ Create New Event</button>
    </div>

    <section className="hero">
      <div>
        <div className="eyebrow" style={{color:"#67e8f9"}}>LAKSHMI NARAIN COLLEGE OF TECHNOLOGY • BHOPAL</div>
        <h2>Plan and manage college events from one simple dashboard.</h2>
        <p>A simple place for students and event coordinators to plan schedules, registrations, volunteers, posters and event-day requirements.</p>
        <div className="hero-chips"><span className="chip">📅 Scheduling</span><span className="chip">🎟 Registration</span><span className="chip">📋 Checklists</span><span className="chip">📣 Promotion</span></div>
        <button className="primary" onClick={()=>setPage("Events")}>Explore Events →</button>
      </div>
      <div className="hero-logo"><img src={LOGO} alt="Lakshmi Narain College of Technology logo"/></div>
    </section>

    <div className="stats">
      <Stat icon="▣" label="Total Events" value={events.length+18} note="+4 this month"/>
      <Stat icon="◷" label="Upcoming" value={events.length} note="Next 30 days"/>
      <Stat icon="✓" label="Registrations" value={1248+registered.length} note="+18.6% this week"/>
      <Stat icon="★" label="Active Teams" value="24" note="Across departments"/>
    </div>

    <div className="grid-2">
      <section className="card">
        <div className="card-head"><div><h3>Upcoming Events</h3><span className="muted">What is happening next at LNCT</span></div><button className="secondary" onClick={()=>setPage("Events")}>View all</button></div>
        <div className="event-list">{events.slice(0,4).map(e=><EventRow key={e.id} event={e} register={register} registered={registered}/>)}</div>
      </section>
      <section className="card">
        <div className="card-head"><div><h3>Event-day essentials</h3><span className="muted">Practical tools for organizers</span></div></div>
        <div className="tools">
          <Tool icon="📋" title="Checklist" text="Setup, stage, AV, volunteers" onClick={()=>notify("Checklist opened")}/>
          <Tool icon="🎤" title="Stage Plan" text="Anchor, mic & program flow" onClick={()=>notify("Stage plan opened")}/>
          <Tool icon="🪪" title="ID / Entry" text="Gate and attendee verification" onClick={()=>notify("Entry workflow opened")}/>
          <Tool icon="📦" title="Inventory" text="Track equipment and supplies" onClick={()=>notify("Inventory opened")}/>
          <Tool icon="🧾" title="Budget" text="Expense and vendor planning" onClick={()=>notify("Budget planner opened")}/>
          <Tool icon="🚨" title="Emergency" text="Contacts and response plan" onClick={()=>notify("Emergency plan opened")}/>
        </div>
      </section>
    </div>

    <section className="card" style={{marginTop:20}}>
      <div className="card-head"><div><h3>Floating Event Posters</h3><span className="muted">Promote important campus events</span></div><button className="secondary" onClick={()=>setPage("Posters")}>Manage posters</button></div>
      <div className="poster-grid">
        <Poster title="TECHFEST 2026" text="Innovation • Coding • Robotics" date="12 OCT"/>
        <Poster title="E-SUMMIT" text="Startup • Pitching • Networking" date="18 OCT"/>
        <Poster title="CULTURAL NIGHT" text="Music • Dance • Celebration" date="02 NOV"/>
      </div>
    </section>
  </div>
}

function Stat({icon,label,value,note}){return <div className="stat"><div className="stat-top"><span>{icon} &nbsp;{label}</span><span>↗</span></div><div className="stat-num">{value}</div><div className="stat-note">{note}</div></div>}
function Tool({icon,title,text,onClick}){return <button className="tool" onClick={onClick}><div className="tool-icon">{icon}</div><b>{title}</b><span>{text}</span></button>}
function Poster({title,text,date}){return <div className="poster"><span className="chip" style={{width:"fit-content"}}>{date}</span><h4>{title}</h4><p>{text}</p></div>}

function EventRow({event,register,registered}){
  return <div className="event">
    <div className="datebox"><b>{event.day}</b><span>{event.month}</span></div>
    <div><div className="event-title">{event.title}</div><div className="event-meta">📍 {event.venue} &nbsp; • &nbsp; ⏰ {event.time}</div><span className={"tag "+event.tag}>{event.category}</span></div>
    <div className="event-actions"><button className="small-btn" onClick={()=>register(event.id)}>{registered.includes(event.id)?"Registered":"Register"}</button></div>
  </div>
}

function Events({events,query,setQuery,setModal,register,registered,notify}){
  return <div>
    <div className="page-head"><div><div className="eyebrow">Event management</div><h1>All Events</h1><p className="subtitle">Discover, organize and manage every LNCT event.</p></div><button className="primary" onClick={()=>setModal("create")}>＋ Create Event</button></div>
    <div className="card">
      <div className="filter-row"><input className="search" value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search events, category, venue..." /><button className="secondary" onClick={()=>notify("Showing all categories")}>All categories</button><button className="secondary" onClick={()=>notify("Upcoming filter applied")}>Upcoming</button></div>
      <div className="event-list">{events.length ? events.map(e=><EventRow key={e.id} event={e} register={register} registered={registered}/>) : <p className="muted">No matching events found.</p>}</div>
    </div>
  </div>
}

function Calendar({events,notify}){
  const days = Array.from({length:30},(_,i)=>i+1);
  return <div>
    <div className="page-head"><div><div className="eyebrow">Schedule</div><h1>Event Calendar</h1><p className="subtitle">A simple monthly view for planning campus activities.</p></div><button className="primary" onClick={()=>notify("Calendar export prepared")}>Export Calendar</button></div>
    <div className="card">
      <div className="card-head"><h3>October 2026</h3><span className="muted">{events.length} active events</span></div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(7,1fr)",gap:7}}>
        {["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].map(d=><div key={d} style={{padding:8,textAlign:"center",fontSize:10,fontWeight:800,color:"#778195"}}>{d}</div>)}
        {Array.from({length:4}).map((_,i)=><div key={"blank"+i}></div>)}
        {days.map(day=>{
          const found=events.find(e=>Number(e.day)===day);
          return <div key={day} style={{minHeight:72,border:"1px solid #e8ecf2",borderRadius:10,padding:8,background:found?"#eef4ff":"white"}}>
            <b style={{fontSize:12}}>{day}</b>{found&&<div style={{fontSize:9,fontWeight:800,color:"#2563eb",marginTop:8}}>{found.title}</div>}
          </div>
        })}
      </div>
    </div>
  </div>
}

function Registrations({events,registered,notify}){
  const rows = registered.map(id=>events.find(e=>e.id===id)).filter(Boolean);
  return <div>
    <div className="page-head"><div><div className="eyebrow">Attendee management</div><h1>Registrations</h1><p className="subtitle">Track event participation and registration status.</p></div><button className="primary" onClick={()=>notify("Registration report exported")}>Export Report</button></div>
    <div className="stats"><Stat label="Total registrations" value={1248+registered.length} note="+18.6% this week" icon="✓"/><Stat label="Confirmed" value={1190+registered.length} note="95.3% conversion" icon="●"/><Stat label="Pending" value="38" note="Needs review" icon="◷"/><Stat label="Waitlist" value="20" note="Capacity based" icon="!" /></div>
    <div className="card"><div className="card-head"><h3>My registrations</h3><span className="muted">Live local demo data</span></div>
      {rows.length?<div className="table-wrap"><table><thead><tr><th>Event</th><th>Category</th><th>Venue</th><th>Status</th></tr></thead><tbody>{rows.map(e=><tr key={e.id}><td><b>{e.title}</b></td><td>{e.category}</td><td>{e.venue}</td><td><span className="tag green">Confirmed</span></td></tr>)}</tbody></table></div>:<p className="muted">No registrations yet. Register for an upcoming event from the Events page.</p>}
    </div>
  </div>
}

function Resources({notify}){
  const resources=[
    ["📋","Event Checklist","Venue, stage, sound, lights, volunteers, registration desk"],
    ["🎙️","Stage & AV","Microphones, speakers, projector, backup laptop and cables"],
    ["🪑","Venue Setup","Seating layout, entry/exit, signage, help desk and backstage"],
    ["🧑‍🤝‍🧑","Volunteer Plan","Team leads, duty roster, reporting time and responsibilities"],
    ["💰","Budget Sheet","Venue, food, printing, prizes, logistics and contingency"],
    ["🩹","Safety Plan","First aid, emergency exits, security and emergency contacts"],
    ["📣","Promotion Kit","Poster, social post, registration QR and announcement copy"],
    ["🏆","Prize & Certificate","Winner list, certificates, trophies and distribution plan"],
    ["📝","Feedback","QR feedback form, attendance count and post-event report"]
  ];
  return <div>
    <div className="page-head"><div><div className="eyebrow">Operations toolkit</div><h1>Event Resources</h1><p className="subtitle">Practical sections you can actually use while running a college event.</p></div></div>
    <div className="tools" style={{gridTemplateColumns:"repeat(3,1fr)"}}>{resources.map(([i,t,d])=><Tool key={t} icon={i} title={t} text={d} onClick={()=>notify(t+" template opened")}/>)}</div>
  </div>
}

function Posters({notify}){
  return <div>
    <div className="page-head"><div><div className="eyebrow">Promotion center</div><h1>Floating Posters</h1><p className="subtitle">Create a visual event wall for important campus announcements.</p></div><button className="primary" onClick={()=>notify("Poster creator opened")}>＋ Create Poster</button></div>
    <div className="poster-grid">{[
      ["TECHFEST 2026","12 OCT","Innovation • Coding • Robotics"],
      ["E-SUMMIT","18 OCT","Startup • Pitching • Networking"],
      ["CULTURAL NIGHT","02 NOV","Music • Dance • Celebration"],
      ["SPORTS MEET","08 NOV","Cricket • Football • Athletics"],
      ["HACKATHON","15 NOV","24 hours • Build • Pitch"],
      ["FRESHERS' ORIENTATION","20 NOV","Connect • Explore • Grow"]
    ].map(x=><Poster key={x[0]} title={x[0]} date={x[1]} text={x[2]}/>)}</div>
  </div>
}

function CollegeInfo({notify}){
  return <div>
    <div className="page-head"><div><div className="eyebrow">Institution profile</div><h1>Lakshmi Narain College of Technology</h1><p className="subtitle">Bhopal, Madhya Pradesh • LNCT Group</p></div><button className="primary" onClick={()=>notify("College profile saved")}>Save Profile</button></div>
    <div className="about-grid">
      <section className="card" style={{textAlign:"center"}}>
        <img src={LOGO} alt="LNCT logo" style={{width:180,height:180,borderRadius:"50%",objectFit:"cover",border:"6px solid #f0f3f8"}}/>
        <h2 style={{marginBottom:5}}>LNCT Bhopal</h2><p className="muted">Lakshmi Narain College of Technology</p>
        <div className="info-line"><span className="info-ico">📍</span><span>Kalchuri Nagar, Raisen Road, Bhopal, Madhya Pradesh</span></div>
        <div className="info-line"><span className="info-ico">🎓</span><span>Engineering, technology and professional education</span></div>
        <div className="info-line"><span className="info-ico">🌐</span><span>Official college website can be linked here</span></div>
      </section>
      <section className="card"><div className="card-head"><h3>Event ecosystem</h3><span className="muted">Suggested workflow</span></div>
        <div className="timeline">
          {[
            ["Plan","Define objective, date, venue, budget and core team."],
            ["Publish","Create poster, event page and registration form."],
            ["Prepare","Assign volunteers, vendors, AV, seating and security."],
            ["Execute","Run check-in, stage schedule, announcements and support."],
            ["Close","Collect feedback, expenses, attendance and final report."]
          ].map(([a,b])=><div className="timeline-item" key={a}><b>{a}</b><div className="muted" style={{marginTop:4}}>{b}</div></div>)}
        </div>
      </section>
    </div>
  </div>
}

// Form used to create a new event
function CreateModal({onClose,onSave}){
  const [form,setForm]=useState({title:"",category:"Technical",date:"2026-10-30",time:"10:00",venue:"LNCT Auditorium"});
  const update=(k,v)=>setForm({...form,[k]:v});
  const submit=(e)=>{e.preventDefault();if(!form.title.trim()||!form.venue.trim())return;onSave(form)};
  return <div className="overlay" onMouseDown={e=>e.target===e.currentTarget&&onClose()}>
    <form className="modal" onSubmit={submit}>
      <div className="modal-head"><h3>Create New Event</h3><button type="button" className="close" onClick={onClose}>✕</button></div>
      <div className="modal-body"><div className="form-grid">
        <div className="field full"><label>EVENT NAME</label><input required value={form.title} onChange={e=>update("title",e.target.value)} placeholder="e.g. Annual Hackathon"/></div>
        <div className="field"><label>CATEGORY</label><select value={form.category} onChange={e=>update("category",e.target.value)}><option>Technical</option><option>Cultural</option><option>Sports</option><option>Entrepreneurship</option><option>Workshop</option><option>Academic</option></select></div>
        <div className="field"><label>DATE</label><input type="date" required value={form.date} onChange={e=>update("date",e.target.value)}/></div>
        <div className="field"><label>TIME</label><input type="time" required value={form.time} onChange={e=>update("time",e.target.value)}/></div>
        <div className="field"><label>VENUE</label><input required value={form.venue} onChange={e=>update("venue",e.target.value)} placeholder="Venue"/></div>
        <div className="field full"><label>DESCRIPTION</label><textarea rows="4" placeholder="Event objective, audience, registration details..."></textarea></div>
      </div></div>
      <div className="modal-foot"><button type="button" className="secondary" onClick={onClose}>Cancel</button><button className="primary">Create Event</button></div>
    </form>
  </div>
}

function EventDetails(){ return null; }

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>
</body>
</html>
